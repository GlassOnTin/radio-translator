# CPU translation daemon. Whisper weights download on first run (mount a volume
# on /root/.cache/huggingface to persist). Kokoro fetched at build time.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg git curl ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt
COPY . .
RUN python scripts/fetch_models.py || echo "Kokoro fetch deferred to runtime"
EXPOSE 8770
ENTRYPOINT ["python", "tools/translate_daemon.py", "--host", "0.0.0.0", "--port", "8770"]
