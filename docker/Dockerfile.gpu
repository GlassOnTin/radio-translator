# GPU translation daemon (CUDA 12 + cuDNN 9). Requires the NVIDIA Container
# Toolkit (run with --gpus all). GPU images are driver-sensitive; the CPU image
# is the reliable published artifact. Voice isolation + TTS enabled by default.
FROM nvidia/cuda:12.6.3-cudnn-runtime-ubuntu24.04
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip python3-venv ffmpeg git curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt requirements-enhance.txt ./
RUN pip install --no-cache-dir --break-system-packages -r requirements.txt \
    nvidia-cublas-cu12 "nvidia-cudnn-cu12==9.*"
RUN pip install --no-cache-dir --break-system-packages torch==2.15.0 \
    --index-url https://download.pytorch.org/whl/cu126 \
    && pip install --no-cache-dir --break-system-packages -r requirements-enhance.txt
COPY . .
RUN python3 scripts/fetch_models.py || echo "Kokoro fetch deferred to runtime"
EXPOSE 8770
ENTRYPOINT ["/app/docker/entrypoint.sh", "--enhance", "isolate", "--audio-out", "--tts"]
